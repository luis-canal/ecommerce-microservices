# Credenciais do Stripe usadas SOMENTE pelo payment-api (modo teste).
# Copie para docker/.env.payment e preencha. Nunca versione chaves reais.
#
# Chave secreta de teste: sk_test_... ou rk_test_... (a aplicacao nao sobe com outra chave).
STRIPE_SECRET_KEY=
# Segredo de assinatura do webhook: whsec_... (exibido pelo "stripe listen").
STRIPE_WEBHOOK_SECRET=
# Paginas do frontend apos o checkout. A de sucesso deve conter {CHECKOUT_SESSION_ID}.
# Ex.: http://localhost:5173/pagamento/sucesso?session_id={CHECKOUT_SESSION_ID}
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
