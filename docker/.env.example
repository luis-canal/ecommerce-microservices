# Credenciais externas. O consul-config lê este arquivo e grava os valores no Consul;
# os microsserviços leem somente do Consul. Este arquivo não é versionado.

# --- Imagens / S3 (Supabase) ---
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=product-images
STORAGE_PUBLIC_BASE_URL=

# --- Stripe / Payment ---
# Chave secreta de teste: sk_test_... ou rk_test_... (o payment-api não sobe com outra chave).
# Segredo do webhook: whsec_... (exibido pelo "stripe listen").
# PAYMENT_SUCCESS_URL deve conter {CHECKOUT_SESSION_ID}.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
