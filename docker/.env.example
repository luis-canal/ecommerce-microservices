# Credenciais externas. O consul-config lê este arquivo e grava os valores no Consul;
# os microsserviços leem somente do Consul. Este arquivo não é versionado.

# --- Imagens / S3 (Supabase) ---
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=product-images
STORAGE_PUBLIC_BASE_URL=

# --- Stripe / Payment ---
# Chave secreta de teste: sk_test_... ou rk_test_... (o payment-api não sobe com outra chave).
# Segredo do webhook: whsec_... (exibido pelo "stripe listen").
# PAYMENT_SUCCESS_URL / PAYMENT_CANCEL_URL apontam para o retorno do payment-api no Gateway,
# num endereço que o celular alcança (IP da máquina na rede local ou túnel). O payment-api
# acrescenta order_id e redireciona para o deep link do app (PAYMENT_APP_*_URL).
# PAYMENT_SUCCESS_URL deve conter {CHECKOUT_SESSION_ID}.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
# Deep links do app (opcionais; padrão oma://payment/success e oma://payment/cancel).
PAYMENT_APP_SUCCESS_URL=
PAYMENT_APP_CANCEL_URL=
