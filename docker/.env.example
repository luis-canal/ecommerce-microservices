# Credenciais externas. O consul-config lê este arquivo e grava os valores no Consul;
# os microsserviços leem somente do Consul. Este arquivo não é versionado.

# --- Imagens / S3 (Supabase) ---
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=product-images
STORAGE_PUBLIC_BASE_URL=

# --- Provedor de pagamento ---
# simulated (padrão, também quando vazio): SOMENTE PARA DEMONSTRAÇÃO ACADÊMICA. Aprova o
# pagamento na hora, não cobra nada e não precisa de nenhuma variável do Stripe.
# stripe: Stripe Checkout em modo de teste; exige a seção "Stripe / Payment" abaixo.
PAYMENT_PROVIDER=simulated

# --- Stripe / Payment ---
# No modo simulado, deixe esta seção vazia.
# Chave secreta de teste: sk_test_... ou rk_test_... (no modo stripe, o payment-api não sobe com outra chave).
# Segredo do webhook: whsec_... (exibido pelo "stripe listen").
#
# PAYMENT_SUCCESS_URL / PAYMENT_CANCEL_URL (padrão: vazias):
# - stripe: obrigatórias. Apontam para o retorno do payment-api no Gateway, num endereço que o
#   celular alcança (IP da máquina na rede local ou túnel). PAYMENT_SUCCESS_URL deve conter
#   {CHECKOUT_SESSION_ID}. O payment-api acrescenta order_id e redireciona para o deep link do
#   app (PAYMENT_APP_*_URL).
# - simulated: deixe vazias. O checkoutUrl usa o mesmo endereço (Host) com que o cliente chamou
#   o Gateway (ex.: localhost, 10.0.2.2 ou o IP da máquina). Preencha PAYMENT_SUCCESS_URL só se o
#   retorno precisar de outro endereço, por exemplo atrás de um túnel HTTPS. Quando preenchida,
#   ela sempre tem prioridade. PAYMENT_CANCEL_URL não é usada.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
# Deep links do app (opcionais; padrão oma://payment/success e oma://payment/cancel).
PAYMENT_APP_SUCCESS_URL=
PAYMENT_APP_CANCEL_URL=
